/*
 * State Machine Specification — Ohm Grammar
 *
 * The grammar does not distinguish a ownership of states, attributes or values.
 * That is handled by a later post-parse step.
 */

StateMachine {

  // --- Top-level ---

  stateMachineFile
    = ignoredLine*
      title
      overview?
      statesSection
      dataSection?
      transitionsSection
      notesSection?

  // --- Title ---

  // The H1 holds the plain (non-backticked) state machine name only.
  title
    = h1 stateMachineName eol

  stateMachineName
    = (~commentStart ~nl any)+

  // --- Overview ---

  // Each line is consumed with its `EoL` so newlines are not left unread.
  // Stops naturally when `textChar` hits a `sectionStart`.
  overview
    = (text eol)+

  // --- States section ---

  statesSection
    = h2 literal<"States"> eol stateSectionBody notesSubSection?

  stateSectionBody
    = stateDeclaration+ ignoredLine* initialStateLine?

  stateDeclaration
    = listItem identifier stateDescription impliedConditions? -- withDescription
    | listItem identifier comment? nl impliedConditions       -- withoutDescription
    | listItem identifier comment? eol                        -- bare

  // The trailing `ignoredLine*` mirrors `description<stopAt>`, so a blank, comment or heading
  // line may follow a described state the way it may follow any other described entry.
  stateDescription
    = ":" stateDescriptionLine+ ignoredLine*

  stateDescriptionLine
    = ~(sublistItem | listItem | initialStateCaption) textChar+ comment? nl

  initialStateLine
    = initialStateCaption identifier comment? eol

  initialStateCaption
    = "Initial state:" hsp?

  // --- Implied conditions and states ---

  // One or more sub-bullets that follow a state declaration. Each bullet carries exactly one
  // attribute-condition pair, or one bare state name: a state of another machine that holds
  // whenever this state does. A condition is tried first; a state name has no operator after it,
  // so nothing that is a condition can be read as a state.
  impliedConditions
    = (sublistItem impliedEntry comment? eol)+

  impliedEntry
    = conditionalAttributeExpression -- condition
    | identifier                     -- state

  // --- Data section (optional) ---

  dataSection
    = h2 literal<"Data"> eol dataSectionBody notesSubSection?

  dataSectionBody
    = none eol                                                   -- none
    | valuesSection valueCombinationsSection?                    -- valuesOnly
    | valueCombinationsSection                                   -- combinationsOnly
    | attribute+ valuesSection? valueCombinationsSection?        -- withEntries

  attribute
    = listItem identifier attributeDescription -- withDescription
    | listItem identifier comment? eol         -- withoutDescription

  attributeDescription
    = description<listItem>

  // --- Values subsection (optional) ---

  // Per-attribute value lists, standing in for a combinations table: leaving the table out says
  // every combination of these values is a valid one. Pairing values into rows by hand is what
  // the table is for, so the two are mutually exclusive; that is enforced post-parse, not here.
  valuesSection
    = h3 literal<"Values"> eol attributeValues+

  attributeValues
    = listItem identifier ":" hsp? declaredValue (comma declaredValue)* comment? eol

  // A value an attribute may take. `undefined` is the list-form spelling of the empty cell a
  // combinations table uses for an absent value; a bare word is otherwise not a value, so there
  // is nothing for it to collide with.
  declaredValue
    = value                -- literal
    | literal<"undefined"> -- undefined

  // --- Value combinations subsection (optional) ---

  valueCombinationsSection
    = h3 literal<"Value combinations"> eol attributeValuesTable

  attributeValuesTable
    = attributeValuesTableHeader tableSeparatorRow attributeValuesTableRow+ ignoredLine*

  // A trailing `comment?` lets a row be annotated after its closing pipe, the way any other line
  // can be. An `inlineComment` inside a cell stops at the next pipe; this one runs to end of line.
  attributeValuesTableHeader
    = pipe (identifier inlineComment? pipe)+ comment? nl

  attributeValuesTableRow
    = pipe (value? inlineComment? pipe)+ comment? nl

  // A value is either a quoted non-empty string token or a bare number.
  // Which values belong to which attribute is resolved post-parse.
  value
    = string | number

  // --- Transitions section ---

  transitionsSection
    = h2 literal<"Transitions"> eol transitionsSectionBody notesSubSection?

  transitionsSectionBody
    = defaultPreconditions? transitionRules impossibleBlock? irrelevantBlock?

  // --- Default preconditions subsection ---

  // Optional block listing default precondition states for all transitions.
  // The owning machine is resolved from the state name in a post-parse step.
  defaultPreconditions
    = h3 literal<"Default preconditions"> eol defaultPreconditionsBody

  defaultPreconditionsBody
    = none eol            -- none
    | defaultPrecondition+ -- withEntries

  // A described entry parses its arguments with `argumentSuffixBeforeDescription` so a trailing
  // `: description` ends the argument instead of being absorbed into its suffix; an entry without
  // a description keeps the plain, greedy suffix.
  defaultPrecondition
    = listItem stateReference<argumentSuffixBeforeDescription> defaultPreconditionDescription -- withDescription
    | listItem stateReference<argumentSuffix> comment? eol                                    -- withoutDescription

  defaultPreconditionDescription
    = description<listItem>

  // --- Transition rules subsection ---

  // A `### Rules` subsection holds one or more blocks, each either the table form or a single
  // list-form entry; blocks may be mixed and repeated in any order, and their transitions are
  // merged into one list in source order.
  transitionRules = h3 literal<"Rules"> eol transitionRulesBody

  transitionRulesBody
    = transitionRulesBlock+

  transitionRulesBlock
    = transitionsTable
    | transitionListEntry

  transitionsTable
    = transitionsHeaderRow tableSeparatorRow transitionRow+ ignoredLine*

  transitionsHeaderRow
    = pipe
     ("#"       pipe)?
      "States"  pipe
      "Trigger" pipe
      "Result"  pipe
     ("Notes"   pipe)?
      nl

  transitionRow
    = pipe
      (transitionId?   inlineComment? pipe)?
      stateCombination inlineComment? pipe
      trigger          inlineComment? pipe
      result           inlineComment? pipe
      (inlineText?     inlineComment? pipe)?
      nl

  transitionId
    = (~"`" ~pipe ~nl any) (~pipe ~nl any)*

  // --- Transition rules subsection (list form) ---

  // A single transition, written as a nested bulleted entry instead of a table row. The four
  // sub-blocks mirror the table's columns (States/Trigger/Result/Notes) and must appear in that
  // order; Notes is optional, matching the table's optional Notes column. Unlike the table's
  // optional `#` column, the identifier is required here — it is the only label on the entry.
  // An optional description may follow the id's `:`, in the same `: text` shape used for a
  // state or default-precondition description; it folds into the transition's notes.
  transitionListEntry
    = listItem transitionListId description<sublistItem> transitionListBody -- withDescription
    | listItem transitionListId ":" comment? eol transitionListBody         -- withoutDescription

  transitionListId
    = (~":" ~nl ~commentStart any)+

  transitionListBody
    = transitionListStatesBlock
      transitionListTriggerBlock
      transitionListResultBlock
      transitionListNotesBlock?
      ignoredLine*

  transitionListStatesBlock
    = sublistItem literal<"States:"> eol listItemValue+

  transitionListTriggerBlock
    = sublistItem literal<"Trigger:"> eol listItemValue

  transitionListResultBlock
    = sublistItem literal<"Result:"> eol listItemValue

  transitionListNotesBlock
    = sublistItem literal<"Notes:"> eol listItemValue+

  // One sub-sub-list bullet. Its value may continue onto further physical lines so long as they
  // are indented and don't themselves start a new bullet — a soft wrap for long trigger/result
  // expressions. The physical lines are joined into one logical line in a post-parse step, then
  // re-parsed with the same `trigger`/`result` rule used for a table cell.
  listItemValue
    = subsublistItem textChar+ comment? nl continuationLine*

  continuationLine
    = ~(hsp? "-") ~sectionStart textChar+ comment? nl

  // --- State combinations ---

  // A comma-separated list of state references. Ordering and which entry
  // belongs to which machine is interpreted post-parse.
  stateCombination
    = stateReference<argumentSuffix> (comma stateReference<argumentSuffix>)*

  // --- State reference ---

  // A state reference (used in a transition's pre/post-condition) and a state
  // trigger share the same structure: a backticked `identifier` optionally
  // followed by one or more `Argument`s.

  // The `suffix` parameter is the suffix rule the arguments use: it decides where an argument
  // ends, which differs between a table cell and a described list entry.
  stateReference<suffix> = identifier argument<suffix>? (argumentSeparator argument<suffix>)*

  argumentSeparator
    = literal<"and">

  // --- State argument ---

  argument<suffix>
    = hsp? argumentPreQualifier? argumentModifier argumentPostQualifier? argumentExpression suffix? -- withModifier
    | hsp? argumentQualifier? argumentExpression suffix?                                            -- noModifier

  // Separate tokens for Qualifier position to keep that explicit in the AST.
  argumentPreQualifier
    = argumentQualifier

  argumentPostQualifier
    = argumentQualifier

  argumentQualifier
    = literal<"about"> | literal<"on"> | literal<"as"> | literal<"for"> | literal<"from"> | literal<"into"> | literal<"of"> | literal<"so"> | literal<"to"> | literal<"under"> | literal<"with"> | literal<"using">
    | literal<"at"> | literal<"by"> | literal<"over"> | literal<"within"> | literal<"outside"> | literal<"between"> | literal<"against"> | literal<"per"> | literal<"via"> | literal<"around"> | literal<"during">
    | literal<"through">

  argumentModifier
    = literal<"next"> | literal<"previous"> | literal<"first"> | literal<"last">
    | literal<"incremented"> | literal<"decremented">

  // Suffix literals that follow an argument expression and its optional condition.
  // Stops before the next argument, separator, or cell boundary.
  argumentSuffix
    = (~argumentSeparator ~comma ~pipe ~nl ~commentStart any)+

  // As `argumentSuffix`, but also stopping before a `: description` tail, so the description of a
  // list entry whose state reference carries arguments stays a description.
  argumentSuffixBeforeDescription
    = (~argumentSeparator ~comma ~pipe ~nl ~commentStart ~descriptionStart any)+

  descriptionStart
    = ":"

  // Argument expressions reference a backticked `identifier` directly.
  argumentExpression
    = conditionalAttributeExpression -- conditional
    | identifier ~literalSameness    -- bare

  // A condition: an attribute identifier followed by an operator and value(s).
  // The attribute is a generic token; whether the operator/value are valid
  // for the attribute is checked post-parse. A range or set condition only
  // ever takes literal values (a reference is never one of several values);
  // a scalar comparison takes an `attributeValue`, which may be a literal or
  // a reference to another attribute, e.g. `` `attr1` = `attr2` ``, compared
  // per example row against that attribute's own value. Shared with
  // `resultAttributeExpression` below, since a result's value/reference is the
  // same shape. A sameness (`as`) only ever takes a reference.
  // A range keeps its bracket characters, since they carry each bound's inclusivity. `(` is also
  // the set delimiter and both forms share the `in` operator, so the brackets are what tells them
  // apart: a range needs at least one square bracket, leaving the symmetric `( … )` to the set
  // form. `rangeLeftOpen` is therefore tried before `set`, and falls through to it on `)`.
  conditionalAttributeExpression
    = identifier rangeOperator literal<"["> value literal<","> value rangeClose   -- range
    | identifier rangeOperator literal<"("> value literal<","> value literal<"]"> -- rangeLeftOpen
    | identifier setCompare literal<"("> value (comma value)* literal<")">        -- set
    | identifier numericOperator attributeValue                                  -- numericComparison
    | identifier samenessCompare identifier                                      -- sameness
    | identifier textCompare attributeValue                                      -- textComparison
    | identifier undefinedCompare                                                -- undefined
    | identifier definedCompare                                                  -- defined

  // A literal (a quoted string or a bare number) or — by the backtick delimiter alone, with no
  // name-matching involved — a reference naming another attribute to resolve the value from.
  attributeValue
    = value      -- literal
    | identifier -- reference

  undefinedCompare
    = literal<"undefined"> | literal<"is undefined">

  definedCompare
    = literal<"defined"> | literal<"is defined">

  numericOperator
    = literal<">="> | literal<"<="> | literal<"<>"> | literal<">"> | literal<"<"> | literal<"=">

  rangeOperator
      = literal<"in">     -- in
      | literal<"not in"> -- notIn

  // A square-bracketed range closes either way: `[a, b]` (inclusive upper) or `[a, b)`
  // (exclusive upper).
  rangeClose
    = literal<"]"> | literal<")">

  // `as` states sameness — the attribute *takes* the referenced attribute's value — so it binds
  // rather than filters. It only ever names another attribute: a literal needs no binding, and is
  // written with `is` or `=` instead (see `literalSameness`).
  samenessCompare
    = literal<"as">

  // `is`/`are` and `is not`/`are not` are the text spellings of the `=` and `<>` filters. The
  // negative spellings are tried first: `is` would otherwise match the head of `is not` and strand
  // the `not`.
  textCompare
    = literal<"is not"> | literal<"are not">                 -- isNot
    | literal<"is"> | literal<"are">                          -- is

  // `as` followed by a literal. Not a condition: guarding the bare argument forms against it keeps
  // the phrase from being absorbed into a free-text suffix, so it fails to parse instead.
  literalSameness
    = samenessCompare value

  setCompare
    = literal<"in">     -- in
    | literal<"not in"> -- notIn

  // --- Result reference ---
  result = identifier resultArgument? (argumentSeparator resultArgument)*

  resultArgument
    = hsp? argumentPreQualifier? argumentModifier argumentPostQualifier? resultArgumentExpression argumentSuffix? -- withModifier
    | hsp? argumentQualifier? resultArgumentExpression argumentSuffix?                                            -- noModifier

  resultArgumentExpression
    = resultAttributeExpression -- conditional
    | identifier                -- bare

  resultAttributeExpression
    = identifier literal<"set to"> literal<"undefined"> -- undefined
    | identifier literal<"set to"> attributeValue        -- value

  // --- Triggers ---

  // Trigger parsing is generic. State triggers and event triggers are both
  // represented by the same grammar rule; post-parse processing distinguishes
  // the trigger kind.
  trigger
    = stateReference<argumentSuffix>

  // --- Impossible / Irrelevant subsections ---

  impossibleBlock
    = h3 literal<"Impossible"> eol impossibleBlockBody

  impossibleBlockBody
    = none eol             -- none
    | nonTriggerablesTable -- table

  irrelevantBlock
    = h3 literal<"Irrelevant"> eol irrelevantBlockBody

  irrelevantBlockBody
    = none eol             -- none
    | nonTriggerablesTable -- table

  nonTriggerablesTable
    = pipe "States" pipe "Trigger" pipe eol
      tableSeparatorRow
      nonTriggerablesTableRow+
      ignoredLine*

  nonTriggerablesTableRow
    = pipe stateCombination inlineComment? pipe trigger inlineComment? pipe nl

  // --- Notes (sub)section ---

  notesSection    = h2 literal<"Notes"> eol notesSectionBody
  notesSubSection = h3 literal<"Notes"> eol notesSectionBody

  // Each line is consumed with its `EoL` so newlines are not left unread.
  notesSectionBody = (text eol)*

  // --- Identifiers ---

  // Every identifier is a backticked token containing alphanumeric characters
  // only. No semantic meaning is attached here; classification (state vs
  // attribute, text vs numeric, value-to-attribute alignment) happens in a
  // post-parse step.
  // FIXME: This remark about classification might not be correct. Not implemented or not needed ?
  identifier
    = "`" identifierChar+ "`"

  identifierChar
    = ~"`" ~nl any

  // --- Text ---

  // A double-quoted literal value string; empty strings are not allowed.
  string
    = "\"" stringChar+ "\""

  stringChar
    = ~"\"" ~nl any

  description<stopAt>
    = ":" descriptionLine<stopAt>+ ignoredLine*

  descriptionLine<stopAt>
    = ~stopAt textChar+ comment? nl

  text
    = textChar+ comment?

  textChar
    = ~commentStart ~nl ~sectionStart any

  inlineText
    = inlineTextChar+ inlineComment?

  inlineTextChar
    = ~commentStart ~pipe ~nl any

  // --- Number ---

  number = sign? (digit+ fractionalPart? | "." digit+) exponent?
  fractionalPart = "." digit*
  sign = "+" | "-"
  exponent = ("e" | "E") sign? digit+

  // --- Table primitives ---

  tableSeparatorRow = pipe tableSeparatorCell+ nl

  tableSeparatorCell = ":"? "-"+ ":"? pipe

  // --- Literals ---

  literal<lemma>
    = hsp? lemma hsp?

  // Headings — ordered most-specific first to avoid `#` matching `##`.
  h1
    = ~h2 ~h3 "#" hsp+

  h2
    = ~h3 "##" hsp+

  h3
    = ~h4 "###" hsp+

  // Heading levels below `###` carry no meaning: an author's own subdivision of a section.
  // Listing `h4` in `sectionStart` keeps such a heading out of the surrounding `text`; listing
  // it in `ignoredLine` lets it stand wherever a blank or comment line may, and discards it
  // along with them.
  h4
    = "####" "#"* hsp+

  sectionStart
    = h2 | h3 | h4

  listItem
    = "- "

  sublistItem
    = "  - "

  subsublistItem
    = "    - "

  none
    = literal<"None">

  pipe
    = literal<"|">

  comma
    = literal<",">

  // --- Whitespace & Comments ---

  // Stops before the final newline so `EoL` can catch it.
  comment
    = hsp? commentStart (~nl any)*

  inlineComment
    = hsp? commentStart (~pipe ~nl any)*

  commentStart
    = "//"

  // Ensures a statement cleanly ends, absorbing the newline and any
  // subsequent line to ignore.
  eol
    = nl ignoredLine*

  // Blank, comment-only, or free-form heading lines before a next rule begins.
  ignoredLine
    = comment nl  -- comment
    | blankLine   -- blank
    | headingLine -- heading

  // A free-form `####` heading, with whatever follows it on that line.
  headingLine
    = h4 (~nl any)* nl

  blankLine
    = hsp? nl

  hsp
    = (" " | "\t" | "<br/>" | "<br>")+

  nl
    = "\r\n" | "\n"
}
