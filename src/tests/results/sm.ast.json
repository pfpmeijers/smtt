    {
      "name": "m3",
      "overview": "Workflow machine. Tracks a labelled process through its lifecycle. Requires `M1 active` and coordinates with `M2`.",
      "states": [
        {
          "name": "m3 pending",
          "description": "Workflow has not yet been started.",
          "impliedConditions": [
            {
              "attribute": "a4",
              "condition": {
                "operator": "=",
                "value": "0"
              }
            }
          ]
        },
        {
          "name": "m3 open",
          "description": "Workflow is actively progressing.",
          "impliedConditions": [
            {
              "attribute": "a4",
              "condition": {
                "operator": ">",
                "value": "0"
              }
            }
          ]
        },
        {
          "name": "m3 paused",
          "description": "Workflow is temporarily suspended."
        },
        {
          "name": "m3 closed",
          "description": "Workflow has ended, either completed or aborted."
        }
      ],
      "data": {
        "a3": "The label assigned to this workflow instance.",
        "a4": "The progress score accumulated during the workflow."
      },
      "dataExampleValues": [
        {
          "a3": "P1",
          "a4": "0"
        },
        {
          "a3": "P2",
          "a4": "10"
        }
      ],
      "dataOtherValues": [
        {
          "a3": "P3",
          "a4": "20"
        }
      ],
      "defaultPreconditions": [
        {
          "state": "m1 active",
          "description": "Workflow operations require M1 to be active."
        }
      ],
      "transitions": [
        {
          "id": "012",
          "states": [
            {
              "name": "m2 partial"
            },
            {
              "name": "m3 pending",
              "arguments": [
                {
                  "qualifier": "with",
                  "name": "a4",
                  "condition": {
                    "operator": "=",
                    "value": "0"
                  }
                }
              ]
            }
          ],
          "trigger": {
            "name": "e5",
            "arguments": [
              {
                "qualifier": "with",
                "name": "a3"
              }
            ],
            "type": "event"
          },
          "result": {
            "name": "m3 open",
            "arguments": [
              {
                "qualifier": "with",
                "name": "a3"
              },
              {
                "name": "a4",
                "condition": {
                  "operator": "=",
                  "value": "10"
                }
              }
            ]
          },
          "notes": "Starting the workflow assigns label and score"
        },
        {
          "id": "013",
          "states": [
            {
              "name": "m3 open"
            }
          ],
          "trigger": {
            "name": "e6",
            "type": "event"
          },
          "result": {
            "name": "m3 paused"
          }
        },
        {
          "id": "014",
          "states": [
            {
              "name": "m3 paused"
            }
          ],
          "trigger": {
            "name": "e7",
            "type": "event"
          },
          "result": {
            "name": "m3 open"
          }
        },
        {
          "id": "015",
          "states": [
            {
              "name": "m3 open"
            },
            {
              "name": "m2 full"
            }
          ],
          "trigger": {
            "name": "e8",
            "type": "event"
          },
          "result": {
            "name": "m3 closed",
            "arguments": [
              {
                "qualifier": "with",
                "name": "a4",
                "condition": {
                  "operator": "=",
                  "value": "20"
                }
              }
            ]
          },
          "notes": "Completion requires full M2; score set to max"
        },
        {
          "id": "016",
          "states": [
            {
              "name": "m3 open"
